---
layout: default
---

<div class="post">


<header class="post-header">


  <div style="
    display:flex;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:4px;
  ">


    <img
      src="{{ '/assets/img/logo_tsinghua_svm.png' | relative_url }}"
      alt="Tsinghua University"
      style="
        height:50px;
        width:auto;
        object-fit:contain;
        display:block;
      "
    >


    <h1 class="post-title" style="margin:0;">

      {% if site.title == 'blank' %}

        <span class="font-weight-bold">
          {{ site.first_name }}
        </span>

        {{ site.middle_name }}

        {{ site.last_name }}

      {% else %}

        {{ site.title }}

      {% endif %}

    </h1>


  </div>



  <p class="desc">
    {{ page.subtitle }}
  </p>


</header>





<article>


<!-- ===========================
     Hero Section
     =========================== -->


<div class="hero-section">



  <!-- Left text -->

  <div class="hero-text">


    <h1>
      Human-centered<br>
      Vehicle Safety
    </h1>



    <p>
      The Intelligent Safety Laboratory advances human-centered vehicle safety by integrating human cognition, artificial intelligence, experimental research, and engineering approaches toward the vision of zero traffic fatalities and serious injuries.
    </p>



    <a
      class="home-button primary"
      href="{{ '/Research/' | relative_url }}"
    >
      Explore Research
    </a>



    <a
      class="home-button secondary"
      href="{{ '/people/' | relative_url }}"
    >
      Meet the Team
    </a>


  </div>





  <!-- Right slideshow -->

  {% if page.profile.images %}


  <div class="hero-image">


    <div class="home-slideshow">


      {% for image in page.profile.images %}


      <img

        src="{{ '/assets/img/' | append:image | relative_url }}"

        alt="Intelligent Safety Laboratory"

        class="home-slide {% if forloop.first %}active{% endif %}"

      >


      {% endfor %}



    </div>


  </div>


  {% endif %}



</div>





<!-- ===========================
     Page content
     Includes research cards
     =========================== -->


<div class="clearfix">

{{ content }}

</div>





<!-- ===========================
     Social links
     =========================== -->


{% if page.social %}


<div class="social">


<div class="contact-icons">

{% social_links %}

</div>


<div class="contact-note">

{{ site.contact_note }}

</div>


</div>


{% endif %}





</article>


</div>





<!-- ===========================
     Slideshow style
     =========================== -->


<style>


.home-slideshow {


  position:relative;

  width:100%;

  aspect-ratio:4 / 3;

  overflow:hidden;

  border-radius:10px;


}



.home-slideshow .home-slide {


  position:absolute;

  inset:0;

  width:100%;

  height:100%;

  object-fit:cover;

  opacity:0;

  transition:opacity 0.8s ease-in-out;


}



.home-slideshow .home-slide.active {


  opacity:1;


}



</style>





<!-- ===========================
     Slideshow script
     =========================== -->


<script>


document.addEventListener(
"DOMContentLoaded",
function(){


const slides =
document.querySelectorAll(
".home-slideshow .home-slide"
);



if(slides.length <= 1)
return;



let current = 0;



setInterval(function(){


slides[current]
.classList
.remove("active");



current =
(current + 1) % slides.length;



slides[current]
.classList
.add("active");



},4000);



});


</script>
